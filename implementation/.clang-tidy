Checks: >
  -*, bugprone-*, cppcoreguidelines-*, modernize-*, performance-*, readability-*,
  -modernize-use-trailing-return-type, -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers, -cppcoreguidelines-pro-bounds-pointer-arithmetic
WarningsAsErrors: ''
HeaderFilterRegex: '(include|src|tuners|tools|integrations)/.*'
