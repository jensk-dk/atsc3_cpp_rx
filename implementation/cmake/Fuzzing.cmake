# atsc3_add_fuzzer(<name> <source>): libFuzzer target, only with clang and ATSC3_FUZZ=ON.
function(atsc3_add_fuzzer name source)
  if(NOT ATSC3_FUZZ)
    return()
  endif()
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(WARNING "atsc3: fuzz target ${name} skipped (clang required)")
    return()
  endif()
  add_executable(${name} ${source})
  target_link_libraries(${name} PRIVATE atsc3::core)
  target_compile_options(${name} PRIVATE -fsanitize=fuzzer,address,undefined -g -O1)
  target_link_options(${name} PRIVATE -fsanitize=fuzzer,address,undefined)
  set_target_properties(${name} PROPERTIES FOLDER "fuzz")
endfunction()
