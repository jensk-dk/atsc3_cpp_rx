# Locates the VLC plugin SDK and defines VLC::plugin, VLC_PLUGIN_VERSION, VLC_PLUGINSDIR (spec 5.19.4):
#  1. pkg-config vlc-plugin (an installed SDK), unless VLC_SOURCE_DIR is given;
#  2. a VLC source tree: VLC_SOURCE_DIR, or the newest ../vlc/vlc-* beside the repository. Its include/ holds the plugin
#     headers; libvlccore comes from VLC_BUILD_DIR/src/.libs (an out-of-tree build of that source) or the system.
# The plugin ABI is the 3.0 line's "3_0_0f": a module built against the 3.0.24 headers loads into any VLC 3.0.x.
include(GNUInstallDirs)
find_package(PkgConfig QUIET)
if(PkgConfig_FOUND AND NOT VLC_SOURCE_DIR)
  pkg_check_modules(VLC_PLUGIN QUIET IMPORTED_TARGET vlc-plugin)
endif()
if(VLC_PLUGIN_FOUND)
  pkg_get_variable(VLC_PLUGINSDIR vlc-plugin pluginsdir)
  if(NOT TARGET VLC::plugin)
    add_library(VLC::plugin INTERFACE IMPORTED)
    target_link_libraries(VLC::plugin INTERFACE PkgConfig::VLC_PLUGIN)
    target_compile_definitions(VLC::plugin INTERFACE __PLUGIN__ MODULE_STRING="atsc3")
  endif()
  set(VLC_PLUGIN_SOURCE "pkg-config vlc-plugin ${VLC_PLUGIN_VERSION}")
else()
  if(NOT VLC_SOURCE_DIR)
    file(GLOB _vlc_trees LIST_DIRECTORIES true "${PROJECT_SOURCE_DIR}/../vlc/vlc-*")
    list(SORT _vlc_trees)
    list(REVERSE _vlc_trees)
    foreach(_t ${_vlc_trees})
      if(EXISTS "${_t}/include/vlc_plugin.h")
        set(VLC_SOURCE_DIR "${_t}" CACHE PATH "VLC source tree providing the plugin headers")
        break()
      endif()
    endforeach()
  endif()
  if(NOT VLC_SOURCE_DIR OR NOT EXISTS "${VLC_SOURCE_DIR}/include/vlc_plugin.h")
    message(FATAL_ERROR "atsc3: no VLC plugin SDK: install vlc-plugin.pc or set VLC_SOURCE_DIR to a VLC source tree")
  endif()
  set(VLC_PLUGIN_VERSION "unknown")
  if(EXISTS "${VLC_SOURCE_DIR}/configure.ac")
    file(STRINGS "${VLC_SOURCE_DIR}/configure.ac" _ac REGEX "AC_INIT\\(vlc, *[0-9.]+")
    string(REGEX REPLACE ".*AC_INIT\\(vlc, *([0-9.]+).*" "\\1" VLC_PLUGIN_VERSION "${_ac}")
  endif()
  find_library(VLC_CORE_LIBRARY NAMES vlccore libvlccore.so.9
               HINTS "${VLC_BUILD_DIR}/src/.libs" "${VLC_SOURCE_DIR}/src/.libs"
               PATHS /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib /usr/local/lib)
  if(NOT TARGET VLC::plugin)
    add_library(VLC::plugin INTERFACE IMPORTED)
    target_include_directories(VLC::plugin SYSTEM INTERFACE "${VLC_SOURCE_DIR}/include")
    target_compile_definitions(VLC::plugin INTERFACE __PLUGIN__ MODULE_STRING="atsc3" _FILE_OFFSET_BITS=64 _REENTRANT _THREAD_SAFE)
    if(VLC_CORE_LIBRARY)
      target_link_libraries(VLC::plugin INTERFACE "${VLC_CORE_LIBRARY}")
    endif()
  endif()
  if(NOT VLC_PLUGINSDIR)
    set(VLC_PLUGINSDIR "${CMAKE_INSTALL_LIBDIR}/vlc/plugins")
  endif()
  set(VLC_PLUGIN_SOURCE "source tree ${VLC_SOURCE_DIR} (${VLC_PLUGIN_VERSION}, libvlccore: ${VLC_CORE_LIBRARY})")
endif()
message(STATUS "atsc3: VLC plugin SDK from ${VLC_PLUGIN_SOURCE}; plugins dir ${VLC_PLUGINSDIR}")
